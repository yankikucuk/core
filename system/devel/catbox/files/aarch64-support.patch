 }
 
+#if defined(__x86_64__) || defined(__i386__)
 void
 catbox_syscall_handle(struct trace_context *ctx, struct traced_child *kid)
 {
@@ -466,3 +577,60 @@ out:
 	// continue tracing
 	ptrace(PTRACE_SYSCALL, pid, 0, 0);
 }
+#elif defined(__aarch64__)
+void
+catbox_syscall_handle(struct trace_context *ctx, struct traced_child *kid)
+{
+	int syscall;
+	struct user_pt_regs regs;
+	struct iovec iov;
+	pid_t pid;
+
+	pid = kid->pid;
+	get_arm64_regs(pid, &regs);
+	syscall = regs.regs[REG_CALL];
+
+	if (kid->in_syscall) { // returning from syscall
+		// Changing the call number on arm64 does not touch x8, so a
+		// blocked call is recognized by the error code kept at entry
+		// instead of a magic call number.
+		if (kid->error_code) {
+			// the call was skipped, return our error code
+			regs.regs[REG_ERROR] = (long) kid->error_code;
+			iov.iov_base = &regs;
+			iov.iov_len = sizeof(regs);
+			ptrace(PTRACE_SETREGSET, pid, NT_PRSTATUS, &iov);
+			kid->error_code = 0;
+		}
+		kid->in_syscall = 0;
+	} else { // entering syscall
+		kid->in_syscall = 1;
+		kid->error_code = 0;
+
+		// skip extra sigtrap from execve call
+		if (syscall == __NR_execve) {
+			kid->in_execve = 1;
+			goto out;
+		}
+
+		int ret = handle_syscall(ctx, pid, syscall);
+		if (ret != 0 && !ctx->collect_only) {
+			// The call number lives outside the general purpose
+			// registers on arm64 and can only be changed through
+			// NT_ARM_SYSTEM_CALL. Setting it to -1 makes the kernel
+			// skip the call while still reporting the exit stop,
+			// where x0 is replaced with our error code.
+			int skip_call = -1;
+
+			kid->error_code = ret;
+			kid->orig_call = syscall;
+			iov.iov_base = &skip_call;
+			iov.iov_len = sizeof(skip_call);
+			ptrace(PTRACE_SETREGSET, pid, NT_ARM_SYSTEM_CALL, &iov);
+		}
+	}
+out:
+	// continue tracing
+	ptrace(PTRACE_SYSCALL, pid, 0, 0);
+}
+#endif
