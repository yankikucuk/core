From 5c26076ce3b1a6394018085a14ecee6eac54c31e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Yank=C4=B1=20K=C3=BC=C3=A7=C3=BCk?=
 <kendinikertenkelebek@me.com>
Date: Thu, 24 Sep 2026 19:13:46 +0300
Subject: [PATCH 7/7] fix(archinfo): treat _emul32 as an architecture-bound
 build type

Some recipes (openssl, ncurses in pisilinux/core; ten packages in main)
declare their 32-bit packages with <BuildType>_emul32</BuildType> so that
PiSi does not apply its own emul32 environment and the recipe sets up -m32
itself. It is still a 32-bit multilib build and only exists on x86_64, but
the table only listed emul32, so on aarch64 these packages would have been
attempted.

_emul32 is now bound to x86_64 like emul32; the test covers it and the
documentation table lists it.
---
 doc/architectures.md  |  2 +-
 pisi/archinfo.py      | 11 +++++++----
 tests/archinfotest.py |  3 +++
 3 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/doc/architectures.md b/doc/architectures.md
index 6ff6790..11d6615 100644
--- a/doc/architectures.md
+++ b/doc/architectures.md
@@ -8,7 +8,7 @@ the architecture comes from one table, `pisi/archinfo.py`.
 
 | Name (canonical) | Aliases accepted | GNU host triplet | Kernel `ARCH=` | Kernel image | Architecture-bound build types |
 |---|---|---|---|---|---|
-| `x86_64` | `amd64`, `x86-64`, `x64` | `x86_64-pc-linux-gnu` | `x86_64` | `arch/x86/boot/bzImage` | `emul32` (32-bit multilib, `/usr/lib32`) |
+| `x86_64` | `amd64`, `x86-64`, `x64` | `x86_64-pc-linux-gnu` | `x86_64` | `arch/x86/boot/bzImage` | `emul32`, `_emul32` (32-bit multilib, `/usr/lib32`) |
 | `i686` | `i386`, `i486`, `i586` | `i686-pc-linux-gnu` | `i386` | `arch/x86/boot/bzImage` | `pae` |
 | `aarch64` | `arm64`, `armv8` | `aarch64-pc-linux-gnu` | `arm64` | `arch/arm64/boot/Image.gz` | none |
 
diff --git a/pisi/archinfo.py b/pisi/archinfo.py
index d8354e5..300dda1 100644
--- a/pisi/archinfo.py
+++ b/pisi/archinfo.py
@@ -71,9 +71,12 @@ class ArchInfo(object):
 # Build types that only make sense on some architectures. Any other value
 # of <Package buildType="..."> is a recipe's own extra pass and is built on
 # every architecture, as before.
-#   emul32: 32-bit multilib libraries next to the 64-bit ones (x86_64)
-#   pae:    32-bit kernel with physical address extension (i686)
-ARCHITECTURE_BOUND_BUILD_TYPES = ("emul32", "pae")
+#   emul32:  32-bit multilib libraries next to the 64-bit ones (x86_64)
+#   _emul32: the same, for recipes that set up the 32-bit environment
+#            themselves instead of using PiSi's emul32 handling (openssl,
+#            ncurses)
+#   pae:     32-bit kernel with physical address extension (i686)
+ARCHITECTURE_BOUND_BUILD_TYPES = ("emul32", "_emul32", "pae")
 
 _COMMON_FLAGS = "-O2 -pipe -fstack-protector -D_FORTIFY_SOURCE=2"
 
@@ -86,7 +89,7 @@ ARCHITECTURES = {
         kernel_arch="x86_64",
         kernel_image="arch/x86/boot/bzImage",
         # 32-bit userland libraries next to the 64-bit ones (multilib)
-        build_types=("emul32",),
+        build_types=("emul32", "_emul32"),
         multilib_dir="lib32"),
 
     "i686": ArchInfo(
diff --git a/tests/archinfotest.py b/tests/archinfotest.py
index 1de8932..4fbf535 100644
--- a/tests/archinfotest.py
+++ b/tests/archinfotest.py
@@ -53,6 +53,9 @@ class ArchInfoTestCase(unittest.TestCase):
         self.assertTrue(archinfo.get("x86_64").supports_build_type("emul32"))
         self.assertFalse(archinfo.get("aarch64").supports_build_type("emul32"))
         self.assertFalse(archinfo.get("i686").supports_build_type("emul32"))
+        # the variant for recipes with their own 32-bit setup is bound too
+        self.assertTrue(archinfo.get("x86_64").supports_build_type("_emul32"))
+        self.assertFalse(archinfo.get("aarch64").supports_build_type("_emul32"))
         for name in archinfo.ARCHITECTURES:
             self.assertTrue(archinfo.get(name).supports_build_type(""))
 
